# Copy to .env (repo root). Read by backend/config.py.

# SQLite file, rebuilt by `python -m pipeline.run`. Relative to the repo root.
DATABASE_URL=sqlite:///data/basis_trail.db

# Only needed to re-parse the PDF or re-run the agent; the demo reads data/cache/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
USE_CACHED_LLM=true

# Flask
CORS_ORIGINS=http://localhost:3000
# Leave true: approve/override IS the demo
ALLOW_WRITES=true

# Frontend -> API (set in Vercel for the deploy)
NEXT_PUBLIC_API_URL=http://localhost:5001